<?xml version="1.0"?>

<page layout="1column" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>

        <referenceContainer name="product.info.main">
            <container name="product.other.info" htmlClass="product-other-info" htmlTag="div" after="product.info.extrahint">
                <block class="Magento\Cms\Block\Block" name="product-other-info">
                    <arguments>
                        <argument name="block_id" xsi:type="string">product-other-info</argument>
                    </arguments>
                </block>
            </container>
        </referenceContainer>

        <move element="product.info.overview" destination="product.info.main" after="page.main.title"/>

    </body>
</page>
