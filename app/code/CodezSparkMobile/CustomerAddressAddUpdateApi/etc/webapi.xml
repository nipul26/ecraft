<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi/etc/webapi.xsd">
    <route url="/V1/customers/add/addresses" method="POST">
        <service class="CodezSparkMobile\CustomerAddressAddUpdateApi\Api\AddressManagementInterface" method="addAddress"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>

    <route url="/V1/addresses/:addressId" method="PUT">
        <service class="CodezSparkMobile\CustomerAddressAddUpdateApi\Api\AddressManagementInterface" method="updateAddress"/>
        <resources>
            <resource ref="self"/>
        </resources>
    </route>
</routes>